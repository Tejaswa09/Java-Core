<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pavitra Collection</title>
</head>
<body>
    <h1>Welcome to Pavitra Collection</h1>
    <form action="createPartner" method="post">
     Partner Name:   <input type="text" name="partnerName" > <br>
    Address : <input type="text" name="partnerAddress" ><br>
    Mobile Number : <input type="number" name="partnerMobileNumber" > <br>
    Email : <input type="email" name="partnerEmail" ><br>
    Quantity: <input type="number" name="quantity" ><br>
    Total cost: <input type="number" name="cost" >
    <br>
    <button type="submit">Submit</button>
    </form>
</body>
</html>